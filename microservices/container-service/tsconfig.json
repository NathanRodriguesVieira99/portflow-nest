{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2024"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@Types/*": ["src/@types/*"],
      "@Contracts/*": ["src/domain/contracts/*"],
      "@Events/*": ["./src/infrastructure/messaging/events/*"],
      "@Models/*": ["src/domain/*"],
      "@Repositories/*": ["./src/infrastructure/persistence/repositories/*"],
      "@Controllers/*": ["./src/presentation/controllers/*"],
      "@Dtos/*": ["./src/presentation/dtos/*"],
      "@Services/*": ["src/application/usecases/*"],
      "@Infra/*": ["./src/infrastructure/*"],
      "@Shared/*": ["./src/shared/*"]
    },
    "types": ["vitest/globals", "node"],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["./k6/*"]
}
