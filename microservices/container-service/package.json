    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.18.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.0.0",
    "nock": "^14.0.16",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
