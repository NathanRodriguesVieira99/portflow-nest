{
  "name": "container-service",
  "author": "@NathanRodriguesVieira99",
  "description": "",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "license": "UNLICENSED",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch ",
    "start:debug": "nest start --debug --watch ",
    "start:prod": "node --require ./dist/tracing.js dist/main",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:unit": "vitest run --project unit ",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:cov": "vitest run --project unit --coverage ",
    "test:int": "vitest run --project integration ",
    "test:int:cov": "vitest run --project integration --coverage",
    "test:e2e": "vitest run --project e2e ",
    "test:all": "vitest run",
    "test:k6": "cd ../docker && docker compose --profile testing run --rm k6 run /container-service/k6/scenarios/main.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "pnpm prisma db seed"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.27",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-express": "^0.67.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.28.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.65.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.18.0",
    "cache-manager": "^7.2.8",
    "cockatiel": "^4.0.0",
