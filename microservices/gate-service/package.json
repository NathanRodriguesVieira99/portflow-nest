{
  "name": "gate-service",
  "author": "@NathanRodriguesVieira99",
  "description": "",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "keywords": [],
  "main": "src/main.ts",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start:dev": "tsx watch --env-file .env src/main.ts",
    "start:prod": "node dist/main.cjs",
    "lint": "eslint src --ext .ts --fix",
    "test:unit": "jest --selectProjects unit ",
    "test:unit:watch": "jest --selectProjects unit --watch",
    "test:unit:cov": "jest --selectProjects unit --coverage",
    "test:int": "jest --selectProjects integration ",
    "test:int:cov": "jest --selectProjects integration --coverage",
    "test:e2e": "jest --selectProjects e2e ",
    "test:all": "jest --runInBand --passWithNoTests"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@testcontainers/mariadb": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/sinon": "^22.0.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "sinon": "^22.1.0",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
