{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2024"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@Types/*": ["./src/terminal/@types/*"],
      "@Contracts/*": ["src/domain/validators/*"],
      "@Events/*": ["src/terminal/infra/messaging/events/*"],
      "@Models/*": ["src/domain/entities/*"],
      "@Repositories/*": ["src/terminal/infra/persistence/repositories/*"],
      "@Controllers/*": ["src/terminal/infra/controllers/*"],
      "@Dtos/*": ["./src/terminal/presentation/dtos/*"],
      "@Services/*": ["src/application/services/*"],
      "@Infra/*": ["src/terminal/infra/*"],
      "@Shared/*": ["./src/shared/*"]
    },
    "types": ["node", "jest"],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["./k6/*"]
}
