  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "jest --selectProjects unit ",
    "test:unit:watch": "jest --selectProjects unit --watch",
    "test:unit:cov": "jest --selectProjects unit --coverage",
    "test:int": "jest --selectProjects integration ",
    "test:int:cov": "jest --selectProjects integration --coverage",
    "test:e2e": "jest --selectProjects e2e ",
    "test:e2e:watch": "jest --selectProjects e2e --watch",
    "test:all": "jest --passWithNoTests"
  },
