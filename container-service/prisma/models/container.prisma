enum STATUS_CONTAINER {
  ARRIVED
  PENDING_DOCUMENTATION
  DOCUMENTATION_CREATED
  INSPECTION_REQUESTED
  INSPECTION_APPROVED
  INSPECTION_REJECTED
  CUSTOMS_CLEARED
  BLOCKED
  STORED_IN_YARD
  RELEASED
}

model Container {
  id                 String           @id @default(uuid())
  shipId             String           @map("ship_id")
  terminalId         String           @map("terminal_id")
  originCountry      String           @map("origin_country")
  destinationCountry String           @map("destination_country")
  cargoType          String           @map("cargo_type")
  statusContainer    STATUS_CONTAINER @map("status_container")
  arrivalDate        DateTime         @map("arrival_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shipId, statusContainer])
  @@index([terminalId, statusContainer])
  @@index([createdAt(sort: Desc)])
  @@map("containers")
}
