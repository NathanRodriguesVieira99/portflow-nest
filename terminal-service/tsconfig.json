{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2024"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@Types/*": ["./src/terminal/@types/*"],
      "@Contracts/*": ["src/terminal/domain/contracts/*"],
      "@Events/*": ["./src/terminal/infrastructure/messaging/events/*"],
      "@Models/*": ["./src/terminal/domain/models/*"],
      "@Repositories/*": [
        "./src/terminal/infrastructure/persistence/repositories/*"
      ],
      "@Controllers/*": ["./src/terminal/presentation/controllers/*"],
      "@Dtos/*": ["./src/terminal/presentation/dtos/*"],
      "@Services/*": ["./src/terminal/application/services/*"],
      "@Infra/*": ["./src/terminal/infrastructure/*"],
      "@Shared/*": ["./src/shared/*"]
    },
    "types": ["node"],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "exclude": ["./k6/*"]
}
